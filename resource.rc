            VALUE "OriginalFilename", "MAC-Spoofer.exe"
            VALUE "ProductName",      "MAC Identity Spoofer"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
